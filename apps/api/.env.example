# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
# Port the API listens on (the web dev server proxies /api here).
API_PORT=3000

# Matches docker-compose.yml (run `npm run db:up` from the repo root). Port 5433 avoids clashing with a locally installed Postgres.
DATABASE_URL=postgresql://riftroom:riftroom@localhost:5433/riftroom
# Used by `npm test`. Tests wipe this database, keep it separate.
TEST_DATABASE_URL=postgresql://riftroom:riftroom@localhost:5433/riftroom_test

# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173

# Set to 1 when running behind a reverse proxy (needed for correct client IPs).
TRUST_PROXY=0

SESSION_TTL_DAYS=30

# Account lockout: N failed logins for one email within the window.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15

# Per-IP rate limit for /auth/login and /auth/register (requests per minute).
AUTH_RATE_LIMIT_PER_MINUTE=10
