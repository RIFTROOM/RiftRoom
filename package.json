{
  "name": "riftroom",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @riftroom/web",
    "build": "npm run build -w @riftroom/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2"
  }
}
